# Public Supabase client configuration. Use a dedicated non-production project
# for local development; these values are replaced with the selected project at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Delay Alerts Phase 2 is not deployed. Keep this disabled.
DELAY_ALERTS_ENABLED=false
